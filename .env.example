# Demo config. Copy to .env (gitignored) and fill in; read by demo/env.sh, demo/topic.sh and every
# script in demo/triggers. Variables already set in your shell win over this file.

# --- adapter (python -m trunk_canton, via: eval "$(demo/env.sh)") ---
# Splice LocalNet VM: the app-user participant's JSON Ledger API, http://<vm-host>:2975
# demo/localnet (docker, no auth): http://localhost:7575, and leave CANTON_JWT_SECRET empty
CANTON_JSON_API=http://<vm-host>:2975
CANTON_USER=extractor
CANTON_KAFKA_BOOTSTRAP=localhost:19092
CANTON_TX_TOPIC=canton.localnet.tx
CANTON_TOPOLOGY_ALL_PARTIES=1
# one offset file per participant: use another path (or --reset) when you switch nodes
CANTON_OFFSET_FILE=/tmp/trunk-canton/<target>/offset.txt

# --- HS256 JWT minting (empty secret = node without auth, no token sent) ---
CANTON_JWT_SECRET=<hmac-secret>
CANTON_JWT_AUDIENCE=https://canton.network.global

# --- wallets: faucet tap (localnet-smoke.sh) and coin transfer (devnet-transfer.sh) ---
WALLET_SENDER_API=http://<vm-host>:2903
WALLET_SENDER_USER=app-user
WALLET_RECEIVER_API=http://<vm-host>:3903
WALLET_RECEIVER_USER=app-provider
TAP_AMOUNT=13.37

# --- Iou create (devnet-contract-trigger.sh), submitted through CANTON_JSON_API ---
# a user with ParticipantAdmin + CanActAs on SUBMIT_PARTY; the party must be one the adapter reads
SUBMIT_USER=ledger-api-user
SUBMIT_PARTY=<app_user party id>

# --- topology (devnet-trigger.sh): Canton console over ssh + docker on the VM ---
TOPOLOGY_SSH_HOST=<ssh alias of the VM>
TOPOLOGY_CONTAINER=canton
TOPOLOGY_MONITORED_ADMIN_PORT=2902
TOPOLOGY_MONITORED_LEDGER_PORT=2901
TOPOLOGY_CPHOST_ADMIN_PORT=3902
TOPOLOGY_CPHOST_LEDGER_PORT=3901
TOPOLOGY_CANARY=extractor_canary

# --- deployed detector pipeline (optional, only for "Verifying on a deployed detector pipeline"
# in demo/triggers/README.md) ---
CANTON_SCAN_URL=https://<scan-host>
DETECTOR_KAFKA_BOOTSTRAP=<broker>:9092
DETECTOR_ALERT_TOPIC=<alert topic>
DETECTOR_NAMESPACE=<k8s namespace>
DETECTOR_RELEASE=<helm release of the detectors>
