// Put counterparty back to "hosted on p2 only" so 369 / 370 can be re-run on the same node.
val counterparty = p2.parties.list(filterParty = "counterparty::").head.party
val sync1Id = p1.synchronizers.id_of(SynchronizerAlias.tryCreate("sync1"))
val hosts = p2.topology.party_to_participant_mappings.list(sync1Id, filterParty = "counterparty::").flatMap(_.item.participants.map(_.participantId))
if (hosts.contains(p1.id)) {
  logger.info("reset: removing p1 as host of counterparty")
  p2.topology.party_to_participant_mappings.propose_delta(counterparty, removes = List(p1.id), store = sync1Id)
  utils.retry_until_true { p1.topology.party_to_participant_mappings.are_known(sync1Id, Set(counterparty -> p2.id)) }
} else logger.info("reset: counterparty already hosted on p2 only")
logger.info("reset done")
